---
interface Props {
  kind: 'website' | 'application' | 'software';
}

const { kind } = Astro.props;
---

<div
  class="flex h-43 items-center justify-center overflow-hidden rounded-lg border border-line/65 bg-canvas"
  aria-hidden="true"
>
  {kind === 'website' && (
    <svg viewBox="0 0 280 160" class="h-full w-full max-w-80" fill="none">
      <rect x="50" y="25" width="180" height="116" rx="7" fill="white" stroke="#d6deec" />
      <path d="M50 44h180" stroke="#e2e6ed" />
      <circle cx="62" cy="35" r="2" fill="#a7b9d8" />
      <circle cx="69" cy="35" r="2" fill="#d5dfef" />
      <circle cx="76" cy="35" r="2" fill="#d5dfef" />

      <rect x="64" y="59" width="54" height="5" rx="2.5" fill="#18202f" />
      <rect x="64" y="69" width="71" height="5" rx="2.5" fill="#18202f" />
      <rect x="64" y="85" width="60" height="3" rx="1.5" fill="#c0cadb" />
      <rect x="64" y="93" width="49" height="3" rx="1.5" fill="#c0cadb" />
      <rect x="64" y="107" width="37" height="13" rx="3" fill="#2061ef" />

      <rect x="149" y="57" width="66" height="66" rx="5" fill="#edf3ff" />
      <rect
        x="164"
        y="72"
        width="35"
        height="35"
        rx="7"
        transform="rotate(-12 181.5 89.5)"
        fill="#2061ef"
      />
      <rect x="179" y="84" width="25" height="25" rx="5" fill="#93b3fa" />

      <path
        d="m223 114 12 17-8-1-4 7z"
        fill="#18202f"
        stroke="white"
        stroke-width="2"
        stroke-linejoin="round"
      />
    </svg>
  )}

  {kind === 'application' && (
    <svg viewBox="0 0 280 160" class="h-full w-full max-w-80" fill="none">
      <rect x="44" y="25" width="192" height="116" rx="7" fill="white" stroke="#d6deec" />
      <path d="M87 25v116" stroke="#e2e6ed" />
      <rect x="56" y="38" width="18" height="5" rx="2.5" fill="#2061ef" />
      <rect x="53" y="55" width="26" height="13" rx="3" fill="#eaf0ff" />
      <path
        d="M58 61.5h16M58 78h15M58 92h12M58 106h14"
        stroke="#a7b9d8"
        stroke-width="3"
        stroke-linecap="round"
      />

      <rect x="101" y="38" width="61" height="5" rx="2.5" fill="#18202f" />
      <rect x="101" y="55" width="36" height="25" rx="4" fill="#f1f4fa" />
      <rect x="143" y="55" width="36" height="25" rx="4" fill="#edf3ff" />
      <rect x="185" y="55" width="36" height="25" rx="4" fill="#f1f4fa" />

      <path d="M101 125h121M101 108h121M101 91h121" stroke="#f0f2f7" />
      <path d="m102 119 19-9 20 4 20-17 20 7 20-13 20-4v39H102Z" fill="#edf3ff" />
      <path
        d="m102 119 19-9 20 4 20-17 20 7 20-13 20-4"
        stroke="#2061ef"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="221" cy="87" r="3" fill="#2061ef" stroke="white" stroke-width="2" />
    </svg>
  )}

  {kind === 'software' && (
    <svg viewBox="0 0 280 160" class="h-full w-full max-w-80" fill="none">
      <path d="M81 80h118M140 49v62" stroke="#afc4ef" stroke-width="1.5" stroke-dasharray="4 4" />
      <path d="M81 80V49h59m0 62h59V80" stroke="#c8d7f2" stroke-width="1.5" />

      <rect x="52" y="58" width="53" height="44" rx="8" fill="white" stroke="#d6deec" />
      <path
        d="m75 72-8 8 8 8m8-16 8 8-8 8"
        stroke="#697386"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <rect x="115" y="25" width="50" height="43" rx="8" fill="#2061ef" />
      <path
        d="m129 42 11-6 11 6v11l-11 6-11-6zM129 42l11 6 11-6m-11 6v11"
        stroke="white"
        stroke-width="1.4"
        stroke-linejoin="round"
      />

      <rect x="174" y="58" width="53" height="44" rx="8" fill="white" stroke="#d6deec" />
      <ellipse cx="200.5" cy="74" rx="10" ry="4" stroke="#697386" stroke-width="1.5" />
      <path
        d="M190.5 74v13c0 5.3 20 5.3 20 0V74m-20 6.5c0 5.3 20 5.3 20 0"
        stroke="#697386"
        stroke-width="1.5"
      />

      <rect x="115" y="96" width="50" height="39" rx="8" fill="white" stroke="#d6deec" />
      <path
        d="m132 115 5 5 10-11"
        stroke="#2061ef"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )}
</div>
