---
interface Props {
  number: string;
  label: string;
  class?: string;
}

const { number, label, class: className } = Astro.props;
---

<p class:list={['eyebrow flex items-center gap-3 text-muted', className]}>
  <span class="text-brand">{number}</span>
  <span class="h-px w-5 bg-line" aria-hidden="true"></span>
  {label}
</p>
