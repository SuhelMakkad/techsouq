---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Techsouq home"
  class:list={['inline-flex shrink-0 items-center gap-2.5 rounded-sm', className]}
>
  <img src="/brand/techsouq-monogram.svg" width="38" height="38" alt="" />
  <span class="text-[26px] leading-none font-bold tracking-[-0.055em]">
    techsouq<span class="text-brand">.</span>
  </span>
</a>
