---
import ArrowIcon from '@/components/arrow-icon.astro';
import SectionLabel from '@/components/section-label.astro';

const steps = [
  {
    number: '01',
    title: 'Define.',
    description:
      'We start with the right questions. Understand your goals, your users, and the problem worth solving.',
    detail: 'A shared direction',
  },
  {
    number: '02',
    title: 'Design.',
    description:
      'Make the idea tangible. Shape the experience, explore the details, and find what feels right before building.',
    detail: 'A clear blueprint',
  },
  {
    number: '03',
    title: 'Build.',
    description:
      'Bring it to life with considered engineering. Test, refine, and get the details ready for the real world.',
    detail: 'A thoughtful launch',
  },
];
---

<section
  id="approach"
  aria-labelledby="approach-title"
  class="border-y border-line bg-canvas py-20 lg:py-25"
>
  <div class="page-container">
    <SectionLabel number="02" label="How we work" />

    <div class="mt-7 flex flex-col justify-between gap-6 md:flex-row md:items-end md:gap-12">
      <h2 id="approach-title" class="section-heading max-w-lg">
        A clear path.
        <br /> A shared purpose.
      </h2>
      <p class="max-w-sm text-sm leading-7 text-muted">
        Good products come from working together. We keep the process open, the thinking clear, and
        you part of the conversation.
      </p>
    </div>

    <div class="mt-13 grid gap-10 md:grid-cols-3 md:gap-9">
      {steps.map((step, index) => (
        <article>
          <div class="flex items-center gap-4" aria-hidden="true">
            <span
              class:list={[
                'flex size-10 shrink-0 items-center justify-center rounded-full border text-[11px] font-semibold',
                index === 0
                  ? 'border-brand bg-brand text-white'
                  : 'border-line bg-white text-muted',
              ]}
            >
              {step.number}
            </span>
            <span class="h-px flex-1 bg-line"></span>
            {index < 2 && <ArrowIcon class="size-4 text-muted/60" />}
          </div>

          <h3 class="mt-6 text-[27px] font-semibold tracking-[-0.04em]">{step.title}</h3>
          <p class="mt-3 max-w-xs text-[13px] leading-[1.9] text-muted">{step.description}</p>
          <p class="mt-5 flex items-center gap-2 text-[11px] font-semibold">
            <span class="size-1 rounded-full bg-brand" aria-hidden="true"></span>
            {step.detail}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
