---
import {
  intendedDestination,
  intendedStatus,
  sampleRedirectRows,
} from '@/modules/blog/utils/redirect-planner';
---

<section class="redirect-planner" data-redirect-planner aria-label="Redirect-map planner">
  <div class="planner-heading">
    <p class="eyebrow">Interactive worksheet</p>
    <h3>Give every old URL a destination.</h3>
    <p>
      Keep what works, map what moves, and record what retires. Start with this five-page example.
    </p>
  </div>

  <div data-static-example class="static-example">
    <table>
      <caption>Example decisions for a same-domain redesign</caption>
      <thead>
        <tr>
          <th scope="col">Old path</th>
          <th scope="col">Action</th>
          <th scope="col">Destination / status</th>
        </tr>
      </thead>
      <tbody>
        {sampleRedirectRows.map((row) => (
          <tr>
            <th scope="row">
              <code>{row.source}</code>
            </th>
            <td>{row.action}</td>
            <td>
              <code>{intendedDestination(row) || 'No replacement'}</code>
              <br />
              {intendedStatus(row)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="planner-note">
      Enable JavaScript to edit these decisions, check the map, and export a CSV.
    </p>
  </div>

  <form hidden data-planner-form novalidate>
    <p class="planner-note">
      Use paths such as <code>/services</code>, without the domain, query string, or fragment. Case,
      encoding, and trailing slashes are preserved. Owner / note is optional.
    </p>
    <div class="planner-rows" data-rows></div>

    <div class="planner-actions">
      <button class="secondary-button" type="button" data-add>
        Add a URL
      </button>
      <button class="primary-button" type="submit">
        Check my map
      </button>
      <button class="secondary-button" type="button" data-export>
        Download CSV
      </button>
    </div>

    <p class="planner-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  </form>

  <p class="planner-note boundary-note">
    Checks cover only the mappings you enter. Confirm real HTTP responses, destination content, and
    server-specific URL behavior before launch. Changes stay in this page and disappear when you
    leave; download your CSV to keep them.
  </p>

  <template data-row-template>
    <fieldset class="planner-row">
      <legend data-row-title>URL decision</legend>

      <div class="row-grid">
        <label class="field">
          <span>Old path</span>
          <input
            data-field="source"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="/old-page"
            required
          />
          <span class="field-feedback" data-feedback="source" hidden></span>
        </label>

        <label class="field">
          <span>Action</span>
          <select data-field="action">
            <option value="keep">Keep · 200</option>
            <option value="move">Move · 301</option>
            <option value="merge">Merge · 301</option>
            <option value="remove">Remove · 404</option>
          </select>
          <span class="field-feedback" data-feedback="action" hidden></span>
        </label>

        <label class="field">
          <span>Destination path</span>
          <input
            data-field="destination"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="/new-page"
          />
          <span class="field-feedback" data-feedback="destination" hidden></span>
        </label>

        <label class="field">
          <span>
            Owner / note <span class="optional">(optional)</span>
          </span>
          <textarea data-field="note" rows="2" placeholder="Who owns this decision?"></textarea>
        </label>
      </div>

      <div class="row-footer">
        <span class="row-outcome" data-outcome></span>
        <button type="button" class="remove-button" data-remove>
          Remove row
        </button>
      </div>
    </fieldset>
  </template>
</section>

<script>
  import {
    intendedStatus,
    redirectRowsToCsv,
    sampleRedirectRows,
    validateRedirectRows,
    type RedirectAction,
    type RedirectRow,
  } from '@/modules/blog/utils/redirect-planner';

  document.querySelectorAll<HTMLElement>('[data-redirect-planner]').forEach((planner, instance) => {
    const form = planner.querySelector<HTMLFormElement>('[data-planner-form]')!;
    const container = planner.querySelector<HTMLElement>('[data-rows]')!;
    const template = planner.querySelector<HTMLTemplateElement>('[data-row-template]')!;

    const status = planner.querySelector<HTMLElement>('[data-status]')!;
    const addButton = planner.querySelector<HTMLButtonElement>('[data-add]')!;
    const exportButton = planner.querySelector<HTMLButtonElement>('[data-export]')!;

    let nextId = 0;
    let checked = false;

    const field = (row: HTMLElement, name: string) =>
      row.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        `[data-field="${name}"]`,
      )!;

    const rowElements = () => [...container.querySelectorAll<HTMLElement>('.planner-row')];
    const readRows = (): RedirectRow[] =>
      rowElements().map((row) => ({
        source: field(row, 'source').value,
        action: field(row, 'action').value as RedirectAction,
        destination: field(row, 'destination').value,
        note: field(row, 'note').value,
      }));

    function refreshRows() {
      rowElements().forEach((row, index) => {
        const action = field(row, 'action').value as RedirectAction;
        const destination = field(row, 'destination');
        const requiresDestination = action === 'move' || action === 'merge';

        destination.disabled = !requiresDestination;
        destination.required = requiresDestination;

        if (!requiresDestination) {
          destination.value = action === 'keep' ? field(row, 'source').value : '';
          destination.placeholder = action === 'remove' ? 'No replacement' : 'Same as old path';
        } else {
          destination.placeholder = '/new-page';
        }

        row.querySelector<HTMLElement>('[data-row-title]')!.textContent = `URL ${index + 1}`;
        row
          .querySelector<HTMLButtonElement>('[data-remove]')!
          .setAttribute('aria-label', `Remove URL ${index + 1}`);
        row.querySelector<HTMLElement>('[data-outcome]')!.textContent =
          `Planned response: ${intendedStatus(action)}${action === 'keep' ? ' · no redirect' : action === 'remove' ? ' · no replacement' : ' · permanent redirect'}`;
      });
    }

    function addRow(value: RedirectRow, focus = false) {
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const id = `redirect-${instance}-${nextId++}`;

      Object.entries(value).forEach(([name, input]) => {
        field(row, name).value = input;
      });

      ['source', 'action', 'destination'].forEach((name) => {
        const feedback = row.querySelector<HTMLElement>(`[data-feedback="${name}"]`)!;

        feedback.id = `${id}-${name}-feedback`;
        field(row, name).setAttribute('aria-describedby', feedback.id);
      });

      container.append(row);
      refreshRows();

      if (focus) field(row, 'source').focus();
    }

    function checkMap(announce = true, focusError = false) {
      const rows = readRows();
      const issues = validateRedirectRows(rows);
      const errors = issues.filter((issue) => issue.severity === 'error');

      rowElements().forEach((row, rowIndex) => {
        ['source', 'action', 'destination'].forEach((name) => {
          const feedback = row.querySelector<HTMLElement>(`[data-feedback="${name}"]`)!;
          const relevant = issues.filter(
            (issue) => issue.rowIndex === rowIndex && issue.field === name,
          );
          const invalid = relevant.some((issue) => issue.severity === 'error');

          feedback.textContent = relevant
            .map((issue) => `${issue.severity === 'warning' ? 'Warning: ' : ''}${issue.message}`)
            .join(' ');
          feedback.hidden = !relevant.length;
          feedback.dataset.severity = invalid ? 'error' : 'warning';

          field(row, name).setAttribute('aria-invalid', String(invalid));
        });
      });

      if (announce) {
        const warnings = issues.length - errors.length;

        status.textContent = !rows.length
          ? 'Add at least one URL before checking or exporting your map.'
          : errors.length
            ? `${errors.length} ${errors.length === 1 ? 'error' : 'errors'} to fix before export. Review the marked fields.`
            : warnings
              ? `${rows.length} URLs checked. ${warnings} redirect-chain ${warnings === 1 ? 'warning' : 'warnings'} to review; CSV export is available. Live URLs have not been tested.`
              : `${rows.length} URLs checked. No mapping issues found; live URLs have not been tested.`;
      }

      if (focusError && errors[0]) {
        field(rowElements()[errors[0].rowIndex], errors[0].field).focus();
      }

      checked = true;

      return rows.length > 0 && errors.length === 0;
    }

    sampleRedirectRows.forEach((row) => addRow(row));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      checkMap(true, true);
    });

    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement | HTMLSelectElement;

      if (target.dataset.field === 'action') {
        const row = target.closest<HTMLElement>('.planner-row')!;

        const destination = field(row, 'destination');

        if (destination.disabled) destination.value = '';
      }

      refreshRows();
      status.textContent = '';

      if (checked) checkMap(false);
    });

    addButton.addEventListener('click', () => {
      addRow({ source: '', action: 'move', destination: '', note: '' }, true);
      status.textContent = `URL ${rowElements().length} added. Enter the old path and choose its action.`;
    });

    container.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');

      if (!button) return;

      const row = button.closest<HTMLElement>('.planner-row')!;
      const index = rowElements().indexOf(row);

      row.remove();
      refreshRows();

      const nextRow = rowElements()[index] ?? rowElements()[index - 1];

      if (nextRow) field(nextRow, 'source').focus();
      else addButton.focus();

      if (checked) checkMap(false);

      status.textContent = `URL ${index + 1} removed. ${rowElements().length} URLs remain.`;
    });

    exportButton.addEventListener('click', () => {
      if (!checkMap(true, true)) return;

      const csv = redirectRowsToCsv(readRows());
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');

      link.href = url;
      link.download = 'website-redirect-map.csv';
      document.body.append(link);

      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);

      status.textContent +=
        ' CSV download requested. Notes that resemble spreadsheet formulas are exported as text.';
    });

    planner.querySelector<HTMLElement>('[data-static-example]')!.hidden = true;
    form.hidden = false;
  });
</script>

<style>
  .redirect-planner {
    margin: 2rem 0;
    padding: clamp(1.1rem, 4vw, 2rem);
    border: 1px solid #dbe3f2;
    border-radius: 1.25rem;
    background: #f7f8fb;
    color: #18202f;
    font-size: 1rem;
    line-height: 1.65;
  }

  .redirect-planner [hidden] {
    display: none !important;
  }
  .planner-heading p {
    margin: 0.7rem 0 1.25rem;
  }
  .planner-heading .eyebrow {
    margin: 0 0 0.6rem;
    color: #2061ef;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .planner-heading h3 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .planner-note {
    margin: 1rem 0;
    color: #536079;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .boundary-note {
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #dbe3f2;
  }
  .planner-rows {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .planner-row {
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border: 1px solid #dbe3f2;
    border-radius: 0.8rem;
    background: white;
  }
  .planner-row legend {
    padding: 0 0.4rem;
    color: #2061ef;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .row-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .optional {
    color: #536079;
    font-weight: 400;
  }

  .field input,
  .field select,
  .field textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 2.8rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid #bdc8db;
    border-radius: 0.45rem;
    background: white;
    color: #18202f;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
  }

  .field textarea {
    resize: vertical;
  }
  .field input:disabled {
    background: #f7f8fb;
    color: #536079;
  }
  .field [aria-invalid='true'] {
    border-color: #b42318;
  }
  .field-feedback {
    overflow-wrap: anywhere;
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .field-feedback[data-severity='error'] {
    color: #a91d16;
  }
  .field-feedback[data-severity='warning'] {
    color: #825000;
  }
  .row-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .row-outcome {
    color: #536079;
    font-size: 0.73rem;
  }
  .planner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  button {
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }
  .primary-button {
    background: #2061ef;
    color: white;
  }
  .primary-button:hover {
    background: #174dcc;
  }
  .secondary-button {
    border-color: #bdc8db;
    background: white;
    color: #18202f;
  }
  .secondary-button:hover {
    border-color: #2061ef;
    color: #2061ef;
  }
  .remove-button {
    flex-shrink: 0;
    padding: 0.45rem;
    background: transparent;
    color: #536079;
    font-size: 0.74rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .remove-button:hover {
    color: #a91d16;
  }
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid #2061ef;
    outline-offset: 3px;
  }
  .planner-status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .static-example {
    overflow-x: auto;
  }
  .static-example table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .static-example caption {
    margin-bottom: 0.7rem;
    text-align: left;
    font-weight: 700;
  }
  .static-example th,
  .static-example td {
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid #dbe3f2;
    text-align: left;
    vertical-align: top;
  }
  .static-example code {
    overflow-wrap: anywhere;
  }

  @media (max-width: 540px) {
    .row-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .row-footer {
      align-items: flex-start;
      flex-direction: column;
    }
    .planner-actions button {
      width: 100%;
    }
  }
</style>
