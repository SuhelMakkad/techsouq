<section
  class="permission-explorer"
  data-permission-explorer
  aria-label="Fictional permission explorer"
>
  <div class="explorer-heading">
    <p class="eyebrow">Interactive example</p>
    <h3>Try one technician request.</h3>
    <p>
      This explorer applies the fictional policy below. The role is always technician; it does not
      check permissions in your own application.
    </p>
  </div>

  <p class="static-rule">
    <strong>Fixed rule:</strong> an active technician may view job ID, site, appointment, and work
    notes on assigned jobs, open or closed. Editing work notes also requires an open job. Billing
    fields and job-list exports are always denied.
  </p>

  <noscript>
    <p class="explorer-note">
      Enable JavaScript to change the example. The permission matrix and worked examples in this
      article explain the same rules without it.
    </p>
  </noscript>

  <form data-explorer-form hidden novalidate autocomplete="off">
    <fieldset>
      <legend>Fictional technician request</legend>

      <div class="field-grid">
        <label class="field">
          <span>Account</span>
          <select name="account" data-field="account">
            <option value="active" selected>
              Active
            </option>
            <option value="suspended">Suspended</option>
          </select>
        </label>

        <label class="field">
          <span>Job assignment</span>
          <select name="assignment" data-field="assignment">
            <option value="assigned" selected>
              Assigned to you
            </option>
            <option value="unassigned">Not assigned to you</option>
          </select>
        </label>

        <label class="field">
          <span>Job status</span>
          <select name="jobStatus" data-field="jobStatus">
            <option value="open" selected>
              Open
            </option>
            <option value="closed">Closed</option>
          </select>
        </label>

        <label class="field">
          <span>Action</span>
          <select name="action" data-field="action">
            <option value="view-work" selected>
              View work details
            </option>
            <option value="edit-notes">Edit work notes</option>
            <option value="view-billing">View billing fields</option>
            <option value="export-jobs">Export job list</option>
          </select>
        </label>
      </div>
    </fieldset>

    <div class="explorer-actions">
      <button class="primary-button" type="submit">
        Check example permission
      </button>
      <button class="secondary-button" type="button" data-reset>
        Reset example
      </button>
    </div>

    <div class="example-result" data-result role="status" aria-live="polite" aria-atomic="true">
      <p class="result-title" data-result-title></p>
      <p class="result-reason" data-result-reason></p>
    </div>
  </form>

  <p class="explorer-note boundary-note">
    These selections stay in page memory and are not sent or saved by this tool. The output
    illustrates only this fixed policy; agreeing on a policy is separate from implementing and
    testing it in a real system.
  </p>
</section>

<script>
  import {
    checkExamplePermission,
    DEFAULT_PERMISSION_EXAMPLE,
    type PermissionExampleField,
  } from '@/modules/blog/utils/permission-explorer';

  document
    .querySelectorAll<HTMLElement>('[data-permission-explorer]')
    .forEach((explorer, index) => {
      const form = explorer.querySelector<HTMLFormElement>('[data-explorer-form]')!;
      const result = explorer.querySelector<HTMLElement>('[data-result]')!;
      const title = explorer.querySelector<HTMLElement>('[data-result-title]')!;

      const reason = explorer.querySelector<HTMLElement>('[data-result-reason]')!;
      const reset = explorer.querySelector<HTMLButtonElement>('[data-reset]')!;
      const fields = Object.keys(DEFAULT_PERMISSION_EXAMPLE) as PermissionExampleField[];

      const control = (field: PermissionExampleField) =>
        form.querySelector<HTMLSelectElement>(`[data-field="${field}"]`)!;

      reason.id = `permission-example-${index}-reason`;

      function renderResult(resetExample = false) {
        const values = Object.fromEntries(fields.map((field) => [field, control(field).value]));
        const checked = checkExamplePermission(values);

        title.textContent = `Example ${checked.allowed ? 'allows' : 'denies'} this action`;
        reason.textContent = `${resetExample ? 'Example reset. ' : ''}${checked.reason}`;
        result.dataset.state = checked.allowed ? 'allowed' : 'denied';

        fields.forEach((field) => {
          const invalid = checked.invalidFields.includes(field);

          control(field).setAttribute('aria-invalid', String(invalid));

          if (invalid) control(field).setAttribute('aria-describedby', reason.id);
          else control(field).removeAttribute('aria-describedby');
        });

        if (checked.invalidFields[0]) control(checked.invalidFields[0]).focus();
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        renderResult();
      });

      form.addEventListener('change', () => {
        title.textContent = 'Selections changed';
        reason.textContent = 'Choose “Check example permission” to apply the fictional policy.';
        result.dataset.state = 'pending';

        fields.forEach((field) => {
          control(field).removeAttribute('aria-invalid');
          control(field).removeAttribute('aria-describedby');
        });
      });

      reset.addEventListener('click', () => {
        fields.forEach((field) => {
          control(field).value = DEFAULT_PERMISSION_EXAMPLE[field];
        });

        renderResult(true);
      });

      fields.forEach((field) => {
        control(field).value = DEFAULT_PERMISSION_EXAMPLE[field];
      });

      renderResult();
      form.hidden = false;
    });
</script>

