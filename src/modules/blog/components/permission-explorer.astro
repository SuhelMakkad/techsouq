  }

  .result-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }

  .result-reason {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }

  .explorer-note {
    margin: 1rem 0;
