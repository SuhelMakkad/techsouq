---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import { getPosts } from '@/modules/blog/lib/posts';
import BlogPost from '@/modules/blog/pages/detail/components/blog-post.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedPosts = (await getPosts()).filter((entry) => entry.id !== post.id).slice(0, 2);
---

<BlogPost post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</BlogPost>
