---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import BaseHead from '@/components/base-head.astro';
import Footer from '@/components/footer.astro';
import FormattedDate from '@/components/formatted-date.astro';
import Header from '@/components/header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-canvas text-ink">
    <Header />

    <main id="main-content" tabindex="-1" class="px-6 pb-24 pt-16 outline-none md:px-10 md:pt-24">
      <article>
        <section class="mx-auto max-w-3xl">
          <header class="mb-10 border-b border-line pb-10">
            <a href="/" class="mb-8 inline-flex text-sm font-medium text-brand hover:underline">
              Back to Techsouq
            </a>

            <div class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span>
                  Updated <FormattedDate date={updatedDate} />
                </span>
              )}
            </div>

            <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">{title}</h1>
            <p class="mt-6 text-lg leading-relaxed text-muted">{description}</p>
          </header>

          {heroImage && (
            <Image
              src={heroImage}
              width={1536}
              height={864}
              alt=""
              class="mb-12 h-auto w-full rounded-2xl"
            />
          )}

          <div class="article-body">
            <slot />
          </div>
        </section>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .article-body {
    font-size: 1.0625rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-block: 1.5rem;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;

    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .article-body :global(h2) {
    font-size: 1.75rem;
  }

  .article-body :global(h3) {
    font-size: 1.375rem;
  }

  .article-body :global(h4) {
    font-size: 1.125rem;
  }

  .article-body :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article-body :global(ul) {
    padding-left: 1.5rem;
    list-style: disc;
  }

  .article-body :global(ol) {
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .article-body :global(li + li) {
    margin-top: 0.5rem;
  }

  .article-body :global(blockquote) {
    margin-block: 2rem;
    border-left: 3px solid var(--color-brand);
    padding-left: 1.5rem;

    color: var(--color-muted);
  }

  .article-body :global(code) {
    border-radius: 0.25rem;
    background: var(--color-line);
    padding: 0.15em 0.35em;

    font-size: 0.875em;
  }

  .article-body :global(pre) {
    margin-block: 2rem;
    overflow-x: auto;
    border-radius: 0.75rem;

    padding: 1.25rem;
    line-height: 1.65;
  }

  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .article-body :global(img) {
    margin-block: 2rem;
    max-width: 100%;
    height: auto;

    border-radius: 0.75rem;
  }

  .article-body :global(table) {
    display: block;
    margin-block: 2rem;
    overflow-x: auto;

    border-collapse: collapse;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 1rem;
    text-align: left;
  }

  .article-body :global(hr) {
    margin-block: 2.5rem;
    border-color: var(--color-line);
  }
</style>
